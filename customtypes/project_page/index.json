{
  "format": "page",
  "id": "project_page",
  "json": {
    "Main": {
      "uid": {
        "config": {
          "label": "Slug"
        },
        "type": "UID"
      },
      "title": {
        "config": {
          "label": "Title",
          "placeholder": ""
        },
        "type": "Text"
      },
      "content": {
        "config": {
          "allowTargetBlank": true,
          "label": "Content",
          "multi": "paragraph,preformatted,heading1,heading2,heading3,heading4,heading5,heading6,strong,em,hyperlink,image,embed,list-item,o-list-item,rtl",
          "placeholder": ""
        },
        "type": "StructuredText"
      },
      "image": {
        "config": {
          "constraint": {},
          "label": "Image",
          "thumbnails": []
        },
        "type": "Image"
      },
      "client": {
        "config": {
          "label": "Client",
          "placeholder": ""
        },
        "type": "Text"
      },
      "archived": {
        "config": {
          "default_value": true,
          "label": "Archived",
          "placeholder_false": "false",
          "placeholder_true": "true"
        },
        "type": "Boolean"
      },
      "publication_date": {
        "config": {
          "label": "Publication date",
          "placeholder": "Date utilisée pour l'ordre d'affichage "
        },
        "type": "Date"
      },
      "creation_date": {
        "config": {
          "label": "Creation date",
          "placeholder": ""
        },
        "type": "Date"
      },
      "credits": {
        "config": {
          "allowTargetBlank": true,
          "label": "Credits",
          "multi": "paragraph,strong,em,hyperlink",
          "placeholder": ""
        },
        "type": "StructuredText"
      },
      "links": {
        "config": {
          "allowTargetBlank": true,
          "allowText": true,
          "label": "links",
          "placeholder": "",
          "repeat": true,
          "select": null,
          "variants": [
            "Primary",
            "Secondary"
          ]
        },
        "type": "Link"
      },
      "slices": {
        "config": {
          "choices": {
            "media_slice": {
              "type": "SharedSlice"
            },
            "simple_text_slice": {
              "type": "SharedSlice"
            },
            "all_fields_test": {
              "type": "SharedSlice"
            }
          }
        },
        "fieldset": "Slice Zone",
        "type": "Slices"
      }
    },
    "SEO & Metadata": {
      "meta_title": {
        "config": {
          "label": "Meta Title",
          "placeholder": "A title of the page used for social media and search engines"
        },
        "type": "Text"
      },
      "meta_description": {
        "config": {
          "label": "Meta Description",
          "placeholder": "A brief summary of the page"
        },
        "type": "Text"
      },
      "meta_image": {
        "config": {
          "constraint": {
            "height": 1260,
            "width": 2400
          },
          "label": "Meta Image",
          "thumbnails": []
        },
        "type": "Image"
      }
    }
  },
  "label": "Project page",
  "repeatable": true,
  "status": true
}
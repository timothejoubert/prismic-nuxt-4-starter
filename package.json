{
    "name": "prismic-nuxt-4-starter",
    "version": "0.0.1",
    "type": "module",
    "private": true,
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "build": "nuxt build",
        "dev": "nuxt dev",
        "generate": "nuxt generate",
        "preview": "nuxt preview",
        "postinstall": "nuxt prepare",
        "lint": "pnpm lint:js && pnpm lint:css",
        "lint-fix": "pnpm lint:js --fix && pnpm lint:css --fix",
        "lint:js": "eslint .",
        "lint:css": "stylelint \"**/*.{vue,css,scss}\"",
        "typecheck": "nuxt typecheck",
        "type-gen": "npx prismic gen types && node scripts/sync-prismic-routes.js"
    },
    "dependencies": {
        "@nuxt/icon": "2.6.2",
        "@nuxt/image": "2.2.1",
        "@nuxtjs/i18n": "10.6.0",
        "@nuxtjs/robots": "^7.0.2",
        "@nuxtjs/sitemap": "^9.1.0",
        "@videojs/html": "10.4.0",
        "@videojs/vimeo-video": "10.4.0",
        "@videojs/youtube-video": "10.4.0",
        "@vueuse/nuxt": "^15.0.0",
        "nuxt": "^4.6.4",
        "nuxt-schema-org": "^7.0.1",
        "ufo": "^1.6.4",
        "vite-svg-loader": "^5.1.3",
        "vue": "^3.5.45",
        "vue-router": "^5.5.1"
    },
    "devDependencies": {
        "@nuxt/eslint": "1.17.0",
        "@nuxtjs/prismic": "^5.4.0",
        "@prismicio/client": "^7.23.1",
        "@prismicio/vue": "^6.2.0",
        "@stylistic/stylelint-plugin": "^6.0.1",
        "@types/node": "~24.19.2",
        "eslint": "^10.15.0",
        "include-media": "^2.0.0",
        "postcss-pxtorem": "^6.1.0",
        "sass": "^1.108.2",
        "stylelint": "^18.0.0",
        "stylelint-config-css-modules": "^4.6.0",
        "stylelint-config-idiomatic-order": "^10.0.0",
        "stylelint-config-standard-scss": "^18.0.0",
        "stylelint-config-standard-vue": "^2.0.0",
        "typescript": "~6.0.3",
        "vue-tsc": "^3.3.14"
    }
}
